.env
# ...except the client's own .env, which holds committed *defaults* (currently
# just VITE_APP_NAME) rather than secrets — a deployer overrides it locally
# via client/.env.local, which stays covered by the blanket rule above.
!/client/.env
/dev.js
/dev-config/
/dev-metadata/
# Personal local Docker deployment (see README) — its own config/metadata
# volumes, and a compose file hardcoding this machine's library path.
/docker-data/
/docker-compose.local.yml
**/node_modules/
/config/
/audiobooks/
/audiobooks2/
/podcasts/
/media/
/metadata/
/plugins/
/client/.nuxt/
/client/dist/
/dist/
/deploy/
/coverage/
/.nyc_output/
/client/playwright-report/
/client/test-results/
/client/playwright/.cache/
/ffmpeg*
/ffprobe*
/unicode*
/libnusqlite3*

sw.*
.DS_STORE
.idea/*
tailwind.compiled.css
tailwind.config.js
