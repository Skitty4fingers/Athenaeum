# Committed defaults for this fork. Override without editing this file by
# creating client/.env.local (gitignored) with the same key — Vite loads
# .env.local after .env and lets it win, which is the point: this file
# documents the default and stays the same across deployments, .env.local
# is where a deployer's actual rebrand lives.

VITE_APP_NAME=Athenaeum
